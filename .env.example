# =============================================================================
# ShiftCore Mission Control - Local Development Environment
# Copy this file to .env. Never commit real credentials or generated JWT keys.
# =============================================================================

# PostgreSQL host configuration
POSTGRES_USER=shiftcore
POSTGRES_PASSWORD=shiftcore_local_dev_only
POSTGRES_DB=shiftcore
POSTGRES_PORT=5432

# Per-service PostgreSQL roles created by the bootstrap scripts
IDENTITY_DB_USER=identity_app
IDENTITY_DB_PASSWORD=identity_local_dev_only
CORE_DB_USER=core_app
CORE_DB_PASSWORD=core_local_dev_only

# Seed data shared between Identity and Core
SEED_DEFAULT_PASSWORD=local_dev_only_change_me
TEAM_ID=3b5f3ec5-cc27-4d68-8f4d-d80545d6b9c1

# Public gateway
NGINX_HTTP_PORT=80
NGINX_SMOKE_URL=http://localhost:80

# Identity and RS256 session contract
JWT_ISSUER=shiftcore-identity
JWT_AUDIENCE=shiftcore-api
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public
SC_TOKEN_COOKIE_NAME=sc_token

# Internal Docker service URL used by AI/Data
CORE_INTERNAL_URL=http://core:4000

# AI/Data release mode and optional protected documentation access
AI_PROVIDER=deterministic
AI_DOCS_ACCESS_KEY=

# Runtime environments
ASPNETCORE_ENVIRONMENT=Development
NODE_ENV=development
PYTHON_ENV=development
