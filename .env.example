# =============================================================================
# ShiftCore Mission Control - Local Environment Contract (R24-04)
# Copy to .env via ./scripts/init-local-env.sh
# NEVER commit real secrets. No real AI provider key is required for this release.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (owned by Mohamed Sameh)
# -----------------------------------------------------------------------------
POSTGRES_USER=shiftcore
POSTGRES_PASSWORD=shiftcore_local_dev_only
POSTGRES_DB=shiftcore
POSTGRES_PORT=5432

# Application roles (created by bootstrap; passwords are local-dev only)
IDENTITY_DB_USER=identity_app
IDENTITY_DB_PASSWORD=identity_local_dev_only
CORE_DB_USER=core_app
CORE_DB_PASSWORD=core_local_dev_only

# -----------------------------------------------------------------------------
# Internal service ports (never expose publicly; Nginx is the only entry point)
# -----------------------------------------------------------------------------
WEB_PORT=3000
IDENTITY_PORT=5001
CORE_PORT=4000
AI_PORT=8000
NGINX_HTTP_PORT=80

# -----------------------------------------------------------------------------
# Identity / JWT (RS256) - private key only in Identity; others get public key
# Placeholders only. Real key material is generated/out-of-band.
# -----------------------------------------------------------------------------
JWT_ISSUER=shiftcore-identity
JWT_AUDIENCE=shiftcore-api
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
SC_TOKEN_COOKIE_NAME=sc_token

# -----------------------------------------------------------------------------
# Service URLs (internal Docker network names)
# -----------------------------------------------------------------------------
IDENTITY_INTERNAL_URL=http://identity:5001
CORE_INTERNAL_URL=http://core:4000
AI_INTERNAL_URL=http://ai:8000

# -----------------------------------------------------------------------------
# AI/Data (non-persisted deterministic preview for Aug 24)
# No real provider key required. Optional stretch only.
# -----------------------------------------------------------------------------
AI_PROVIDER=deterministic
# AI_API_KEY=          # intentionally empty / not required for release path

# -----------------------------------------------------------------------------
# Shared / observability placeholders
# -----------------------------------------------------------------------------
LOG_LEVEL=info
ASPNETCORE_ENVIRONMENT=Development
NODE_ENV=development
PYTHON_ENV=development
