# Database Configuration
POSTGRES_DB=shiftcore_identity
POSTGRES_USER=shiftcore
POSTGRES_PASSWORD=shiftcore_pass

# Identity API Configuration
ASPNETCORE_ENVIRONMENT=Development
IDENTITY_DB_CONNECTION=Host=postgres;Database=shiftcore_identity;Username=shiftcore;Password=shiftcore_pass

# Core API Configuration
CORE_PORT=3000
CORE_DB_CONNECTION=postgres://shiftcore:shiftcore_pass@postgres:5432/shiftcore_identity

# AI/Data API Configuration
AI_PORT=8000
AI_MODE=deterministic

# Frontend Configuration
VITE_API_BASE_URL=/api

# Gateway Configuration
GATEWAY_PORT=80
